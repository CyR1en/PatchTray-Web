# Copy to `.env.local` for local overrides (not committed).
# On Vercel: Project → Settings → Environment Variables (same names).
# Leave a destination empty / unset to keep the disabled / pending UI.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Origin used for canonical URLs. Set this on preview deployments so they do not
# claim the production canonical. Defaults to https://www.patchtray.io.
# VITE_SITE_ORIGIN=

# Version + installer link are read live from the release manifest
# (github.com/CyR1en/PatchTray → latest.json, proxied by /api/release).
# These two are only the fallback for when that page cannot be reached.
VITE_RELEASE_VERSION=0.1.0
VITE_DOWNLOAD_URL=

# Optional: point the browser at a different manifest source (default /api/release)
# VITE_RELEASE_MANIFEST_URL=

VITE_RELEASE_STATE=public beta

# Published Stripe Payment Links. Override only when replacing a link.
VITE_PRO_MONTHLY_CHECKOUT_URL=https://buy.stripe.com/eVq3cu8984Z36Pi9VweQM00
VITE_PRO_LIFETIME_CHECKOUT_URL=https://buy.stripe.com/eVqcN44WWgHLa1u5FgeQM01

# Optional; defaults to support@patchtray.io
# VITE_SUPPORT_EMAIL=

# The footer's repository link and the support, refunds, privacy, and terms
# pages are not configurable. The repo URL comes from RELEASE_REPOSITORY in
# src/lib/release.ts, so it cannot drift from the release manifest; the four
# pages are routes in src/lib/routes.ts.

# Cloudflare Turnstile site key for the /support form. Empty = the form is
# hidden and /support shows only the mailto path.
VITE_TURNSTILE_SITE_KEY=

# --- Server-side only (api/support.js). No VITE_ prefix: these must never
# --- reach the browser bundle. Set them in Vercel, not here, for production.
# RESEND_API_KEY=
# SUPPORT_TO_EMAIL=support@patchtray.io
# SUPPORT_FROM_EMAIL=PatchTray <noreply@patchtray.io>
# TURNSTILE_SECRET_KEY=
# SUPPORT_RATELIMIT_PEPPER=
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are injected by the
# Vercel + Upstash marketplace integration.

# Published Pro pricing (defaults in config.ts if unset)
VITE_PRO_MONTHLY_PRICE=$4.99
VITE_PRO_LIFETIME_PRICE=$29.99
# ISO 4217 currency used by both offers and their structured data
VITE_PRO_PRICE_CURRENCY=USD

# Optional override; if unset, config.ts uses the default requirements copy
# VITE_REQUIREMENTS_TEXT=
